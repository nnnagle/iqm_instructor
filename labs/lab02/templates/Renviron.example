# ------------------------------------------------------------------------------
# EXAMPLE .Renviron  —  DO NOT put your real key in this example file, and do
# NOT commit your real key anywhere.
#
# Your Census API key is a secret. R reads it from a file named `.Renviron` in
# your home directory. Put the line below (with your real key) into THAT file.
#
# The easy, cross-platform way to open the right file:
#
#     install.packages("usethis")   # once
#     usethis::edit_r_environ()     # opens your personal .Renviron in RStudio
#
# Add the line, save, then RESTART R (Session -> Restart R) so R re-reads it.
#
# Where that file actually lives, if you prefer to find it by hand:
#
#   macOS / Linux:   ~/.Renviron
#                    (i.e. /Users/<you>/.Renviron ; the leading dot hides it —
#                     in Finder press Cmd+Shift+. to show hidden files)
#
#   Windows:         C:\Users\<you>\Documents\.Renviron
#                    (R's "home" on Windows is usually your Documents folder;
#                     if unsure, run  normalizePath("~")  in R to see the exact
#                     path R will read. Windows Explorer may not let you name a
#                     file starting with a dot — usethis::edit_r_environ() stores
#                     it for you and avoids that problem.)
#
# Get a free key at: https://api.census.gov/data/key_signup.html
# ------------------------------------------------------------------------------

CENSUS_API_KEY=PASTE_YOUR_KEY_HERE
