# Instructor-side build artifacts and student distributables are generated,
# never authored. Source lives in labs/, data/*.R, R/, templates/.

# Raw downloads, API responses, provenance scratch (per academic year).
/data/build/

# Student-facing packages produced by the build (folders + zips).
/dist/*
!/dist/.gitkeep

